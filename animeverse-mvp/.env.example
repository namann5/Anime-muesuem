# Production API URL (will be set during deployment)
VITE_API_URL=http://localhost:3001

# Build-time admin UI password. Leave UNSET to disable admin access entirely.
# WARNING: Vite inlines VITE_* vars into the client bundle, so this gates UI only
# and is readable by anyone who loads the site. Real access control requires
# Firebase Auth + the rules in firestore.rules / storage.rules.
# The previous hardcoded default was committed and is compromised. Never reuse
# it, and keep this value out of version control -- .env is gitignored.
VITE_ADMIN_PASSWORD=
